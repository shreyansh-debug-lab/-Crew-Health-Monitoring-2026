NODE_ENV=development
PORT=4000
# REQUIRED in production: long random string (e.g. `openssl rand -hex 48`)
JWT_SECRET=
TOKEN_TTL_SECONDS=28800
DB_PATH=./data/crew-health.db
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# If false, unauthenticated GET requests are allowed (read-only "observer"). Writes always need a login.
AUTH_REQUIRED=true
# Key that sensors/gateways send in the X-API-Key header to push telemetry
INGEST_API_KEY=
# First admin account (required in production, created only if no users exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Telemetry simulator (feeds the dashboard with demo data)
SIMULATOR_ENABLED=true
SIM_INTERVAL_MS=2000
# Alerts
ALERT_COOLDOWN_SECONDS=120
AUTO_ALARM_ON_CRITICAL=true
GATE_BLOCK_ON_CRITICAL=true
# Telemetry retention
RETENTION_HOURS=72
